# OpenRouter (Claude via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hermes (local Ollama — run: ollama pull nous-hermes2)
OLLAMA_BASE_URL=http://localhost:11434
HERMES_MODEL=nous-hermes2

# VPS SSH
VPS_HOST=your.vps.ip
VPS_PORT=22
VPS_USER=root
VPS_KEY_PATH=/path/to/your/private/key
# Or use password auth:
# VPS_PASSWORD=your_password

# Obsidian Local REST API plugin (https://github.com/coddingtonbear/obsidian-local-rest-api)
OBSIDIAN_API_URL=http://localhost:27123
OBSIDIAN_API_KEY=your_obsidian_api_key_here
